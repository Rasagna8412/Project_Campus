# Project Campus — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Application Settings
ENVIRONMENT=development
APP_NAME="Project Campus"
APP_VERSION=0.1.0
DEBUG=true
API_V1_STR=/api/v1

# Server Bind
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Local SQLite development fallback:
DATABASE_URL=sqlite+aiosqlite:///./project_campus_dev.db
# PostgreSQL production target (commented for local dev):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/project_campus

# Logging
LOG_LEVEL=INFO
