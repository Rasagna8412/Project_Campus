# Project Campus — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Application Settings
ENVIRONMENT=development
APP_NAME="Project Campus"
APP_VERSION=0.1.0
DEBUG=true
API_V1_STR=/api/v1

# Server Bind
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Local SQLite development fallback:
DATABASE_URL=sqlite+aiosqlite:///./project_campus_dev.db
# PostgreSQL production target (commented for local dev):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/project_campus

# Authentication Security (Generate a strong high-entropy key for production)
SECRET_KEY=dev-insecure-secret-key-change-in-production-campus-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=campus_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Rate Limiting
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
